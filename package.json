{
  "name": "@lyupro/codex-bridge",
  "version": "0.1.0",
  "description": "Delegate implementation, reconnaissance and code review from Claude Code to the Codex CLI: dispatcher agents, a runner that survives a dropped call, and a verdict that checks the report against the worktree.",
  "keywords": [
    "claude-code",
    "codex",
    "codex-cli",
    "subagent",
    "ai-agents",
    "orchestration",
    "hooks"
  ],
  "license": "MIT",
  "author": "Lyu Pro <lyupro.dev@gmail.com> (https://lyupro.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyupro/codex-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/lyupro/codex-bridge/issues"
  },
  "homepage": "https://github.com/lyupro/codex-bridge#readme",
  "type": "module",
  "bin": {
    "codex-bridge": "./bin/codex-bridge.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev:install": "node bin/codex-bridge.mjs update --force",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:size": "node scripts/check-file-size.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
