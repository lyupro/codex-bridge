# Dependencies
node_modules/

# Coverage
coverage/
.nyc_output/

# Environment variables (tokens, keys)
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Run artifacts: data produced by the runner, never part of the package
codex-runs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp files
*.tmp
*.bak

# Agent session state (per-session, not tracked)
**/.omc/
.claude/settings.local.json

# rtk wrapper state: history.db holds the operator's shell history and absolute local paths
rtk/

# The workroom, not the storefront (Plan_36). Plans record why the code is shaped this way,
# checklists are hand-run acceptance the operator performs, audits are one-day snapshots. All three
# are kept and written in full — on disk, in Russian, out of the public repository. None of them
# ever shipped in the package (`npm pack` never included docs/), so nothing downstream changes.
docs/plans/
docs/checklists/
docs/audits/

# Same nature: prompts handed over from other repositories of this operator (dacapo sent the hook
# migration write-up on 2026-08-24). Incoming working material, not documentation of this package —
# a reader of the storefront would take a neighbour's diagnosis for ours.
docs/prompts/
